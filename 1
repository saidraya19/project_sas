function validnumber(prompte)
{
        while(true)
        {
                let value = input.question(prompte)
                let num = Number(value)
                if(!isNaN(num) && value.trim() !== "" && Number.isInteger(num) && num > 0)
                {
                        return num;
                }
                console.clear();
                console.log("type of value invalide, enter number please: ")
        }
}
